# sms-backend base URL (no trailing slash)
SMS_API_URL=http://localhost:4010

# HTTP transport
MCP_HOST=127.0.0.1
MCP_PORT=4020
# Extra Host header values to accept when served behind a proxy/domain
# (DNS-rebinding protection), comma-separated, e.g. mcp.colegios.in
MCP_ALLOWED_HOSTS=

# How long a session's context (roles, classes, subjects) is reused
MCP_CONTEXT_TTL_SECONDS=300
MCP_REQUEST_TIMEOUT_MS=20000

# false: hide confirm_action — the host confirms drafted changes through its
# own UI (see README, "Human in the loop").
MCP_EXPOSE_CONFIRM_TOOL=true

# stdio mode only (local testing with MCP Inspector / Claude Desktop):
# either an agent token, or a user session token + school slug to exchange.
SMS_AGENT_TOKEN=
SMS_USER_TOKEN=
SMS_SCHOOL_SLUG=
